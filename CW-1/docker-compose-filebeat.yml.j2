# Filebeat на web-сервере: читает логи nginx с хоста, шлёт в ES
# ({{ elasticsearch_host }}) подставляется Ansible'ом.
services:
  filebeat:
    image: docker.elastic.co/beats/filebeat:7.17.10
    container_name: filebeat
    user: root
    command: ["-strict.perms=false"]
    volumes:
      - /var/log/nginx:/var/log/nginx:ro
      - ./filebeat.yml:/usr/share/filebeat/filebeat.yml:ro
    environment:
      - ES_JAVA_OPTS=  # не задаём heap по умолчанию, filebeat/go — экономно
    restart: unless-stopped
